TELEGRAM_TOKEN=
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Botdan foydalana oladigan Telegram ID'lar (vergul bilan). Faqat shular xizmat oladi.
# ID ni bilmasangiz: bo'sh qoldirib bo'lmaydi, shuning uchun vaqtincha 1 yozib botni ishga
# tushiring, botga xabar yuboring va logdagi "Ruxsatsiz urinish: id=..." qatoridan oling.
ALLOWED_IDS=

# Namoz vaqtlari (Aladhan). islom.uz bilan solishtirib sozlang
PRAYER_METHOD=3
PRAYER_SCHOOL=1

# Parol seyfi: 1 = yoqilgan, 0 = o'chirilgan
VAULT_ENABLED=1
VAULT_UNLOCK_MINUTES=5
VAULT_SHOW_SECONDS=30
